{
  "name": "enterprise-ai-playbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/serve.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "postbuild": "node scripts/finalize-static.mjs && node scripts/license-notices.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs && node scripts/test-academy-integration.mjs",
    "build:academy": "node scripts/build-academy.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "security:check": "node scripts/check-publication.mjs && node --test scripts/test-audit-policy.mjs scripts/test-lead-endpoint.mjs",
    "security:audit": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.1.0",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "type": "module",
  "description": "Enterprise AI adoption: business use cases, delivery playbooks and FDE engineering education.",
